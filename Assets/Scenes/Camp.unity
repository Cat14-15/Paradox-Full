    bg: -1
  - speaker: "\uB3C4\uC724"
    text: "\uB0B4\uAC00 \uC774\uB04C\uC5B4\uC57C \uD558\uB294\uB370\u2026 \uC65C
      \uC548 \uB530\uB77C\uC624\uC9C0?"
    kind: 2
    portrait: 0
    note: 
    focus: -1
    chatter: 0
    chapter: 
    chapterSub: 
    ambience: 
    ambVol: 0.3
    sfx: 
    sfxVol: 0.8
    operatorOnly: 0
    dark: -1
    bgm: 
    bg: -1
  - speaker: 
    text: "\uB9C8\uB9AC\uC544\uAC00 \uC548\uB0B4\uC2E4 \uCABD\uC744 \uAC00\uB9AC\uD0A4\uBA70
      \uBB34\uC5B8\uAC00\uB97C \uAC15\uD558\uAC8C \uB9D0\uD55C\uB2E4. \uB3C4\uC724\uC5D0\uAC8C\uB294
      \uADF8\uC800 \uC54C \uC218 \uC5C6\uB294 \uC18C\uB9AC\uB2E4. \uADF8\uB54C \uB9B0\uC774
      \uC190\uC804\uB4F1\uC744 \uB3CC\uB824 \uBCBD \uD55C\uCABD\uC744 \uBE44\uCD94\uACE0,
      \uB3C4\uC724\uC758 \uC5B4\uAE68\uB97C \uD1A1\uD1A1 \uB450\uB4DC\uB9B0\uB2E4."
    kind: 1
    portrait: -1
    note: 
    focus: -1
    chatter: 0
    chapter: 
    chapterSub: 
    ambience: 
    ambVol: 0.3
    sfx: 
    sfxVol: 0.8
    operatorOnly: 0
    dark: -1
    bgm: 
    bg: -1
  - speaker: "\uB9B0"
    text: Nhin nay! Nhin nay!
    kind: 0
    portrait: 2
    note: "\uBCBD\uC758 \uADF8\uB9BC\uC744 \uAC00\uB9AC\uD0A4\uBA70"
    focus: -1
    chatter: 0
    chapter: 
    chapterSub: 
    ambience: 
    ambVol: 0.3
    sfx: 
    sfxVol: 0.8
    operatorOnly: 0
    dark: -1
    bgm: 
    bg: -1
  - speaker: 
    text: "\uBC30\uC120\uB3C4\uCC98\uB7FC \uBCF4\uC774\uB294 \uADF8\uB9BC\uC774\uB2E4.
      \uC774\uBC88\uC5D0\uB294 \uC544\uC774\uC0E4\uAC00 \uADF8 \uC704\uC758 \uC0C9\uC0C9
      \uC120\uC744 \uC9DA\uC73C\uBA70 \uC190\uAC00\uB77D\uC73C\uB85C \uD558\uB098\uC529
      \uC13C\uB2E4."
    kind: 1
    portrait: -1
    note: 
    focus: -1
    chatter: 0
    chapter: 
    chapterSub: 
    ambience: 
    ambVol: 0.3
    sfx: 
    sfxVol: 0.8
    operatorOnly: 0
    dark: -1
    bgm: 
    bg: -1
  - speaker: "\uC544\uC774\uC0E4"
    text: Bheka! Imibala! Obomvu, luhlaza... phuzi!
    kind: 0
    portrait: 3
    note: "\uBE68\uAC15, \uD30C\uB791, \uB178\uB791\uC744 \uCC28\uB840\uB85C \uC9DA\uC73C\uBA70"
    focus: -1
    chatter: 0
    chapter: 
    chapterSub: 
    ambience: 
    ambVol: 0.3
    sfx: 
    sfxVol: 0.8
    operatorOnly: 0
    dark: -1
    bgm: 
    bg: -1
  - speaker: "\uB3C4\uC724"
    text: "\uB9C8\uB9AC\uC544\uB294 \uC800\uCABD \uBC29\uC744, \uB9B0\uC740 \uBCBD\uC758
      \uADF8\uB9BC\uC744, \uC544\uC774\uC0E4\uB294 \uC0C9\uC744\u2026 \uB2E4\uB4E4
      \uC11C\uB85C \uB2E4\uB978 \uAC78 \uAC00\uB9AC\uD0A4\uACE0 \uC788\uC5B4."
    kind: 2
    portrait: 0
    note: 
    focus: -1
    chatter: 0
    chapter: 
    chapterSub: 
    ambience: 
    ambVol: 0.3
    sfx: 
    sfxVol: 0.8
    operatorOnly: 0
    dark: -1
    bgm: 
    bg: -1
  - speaker: "\uB3C4\uC724"
    text: "\u2026\uC598\uB124\uAC00 \uB2E4 \uBB54\uAC00 \uC54C\uACE0 \uC788\uC5B4.
      \uB098\uB9CC \uC544\uBB34\uAC83\uB3C4 \uBAA8\uB974\uB124."
    kind: 2
    portrait: 0
    note: 
    focus: -1
    chatter: 0
    chapter: 
    chapterSub: 
    ambience: 
    ambVol: 0.3
    sfx: 
    sfxVol: 0.8
    operatorOnly: 0
    dark: -1
    bgm: 
    bg: -1
  - speaker: 
    text: "\uB124 \uC0AC\uB78C\uC774 \uC11C\uB85C\uB97C \uBC14\uB77C\uBCF8\uB2E4.
      \uAC19\uC740 \uB9D0\uC744 \uC4F0\uB294 \uC0AC\uB78C\uC740 \uC544\uBB34\uB3C4
      \uC5C6\uB2E4. \uD558\uC9C0\uB9CC \uC774 \uC5B4\uB460\uC744 \uBC97\uC5B4\uB098\uB824\uBA74,
      \uAC01\uC790\uAC00 \uBCF8 \uAC83\uC744 \uBAA8\uC544\uC57C \uD55C\uB2E4\uB294
      \uAC74 \uBAA8\uB450\uAC00 \uC548\uB2E4."
    kind: 1
    portrait: -1
    note: 
    focus: -1
    chatter: 0
    chapter: 
    chapterSub: 
    ambience: 
    ambVol: 0.3
    sfx: 
    sfxVol: 0.8
    operatorOnly: 0
    dark: -1
    bgm: 
    bg: -1
  - speaker: 
    text: "[ \uBBF8\uC158 1 ]  \uC804\uC6D0 \uBCF5\uAD6C \u2014 \uC548\uB0B4\uC2E4
      \uBCBD\uC758 \uD4E8\uC988\uD568\uC744 \uCC3E\uC544 \uBC15\uBB3C\uAD00\uC758
      \uC804\uC6D0\uC744 \uB418\uC0B4\uB9B0\uB2E4."
    kind: 1
    portrait: -1
    note: 
    focus: -1
    chatter: 0
    chapter: 
    chapterSub: 
    ambience: 
    ambVol: 0.3
    sfx: ui_select
    sfxVol: 0.8
    operatorOnly: 0
    dark: -1
    bgm: 
    bg: -1
  - speaker: 
    text: "[ \uBBF8\uC158 2 ]  \uCE68\uC218 \uC800\uC9C0 \u2014 \uBB3C\uC774 \uCC28\uC62C\uB77C
      \uBC15\uBB3C\uAD00\uC744 \uB36E\uCE58\uAE30 \uC804\uC5D0 \uBB3C\uAE38\uC744
      \uB9C9\uB294\uB2E4."
    kind: 1
    portrait: -1
    note: 
    focus: -1
    chatter: 0
    chapter: 
    chapterSub: 
    ambience: 
    ambVol: 0.3
    sfx: ui_select
    sfxVol: 0.8
    operatorOnly: 0
    dark: -1
    bgm: 
    bg: -1
  - speaker: 
    text: "\uBC14\uB2E5 \uC544\uB798 \uC5B4\uB518\uAC00\uC5D0\uC11C, \uBB3C\uC774
      \uCC28\uC624\uB974\uB294 \uC18C\uB9AC\uAC00 \uB4E4\uB824\uC628\uB2E4."
    kind: 1
    portrait: -1
    note: 
    focus: -1
    chatter: 0
    chapter: 
    chapterSub: 
    ambience: storm_wind
    ambVol: 0.4
    sfx: siren_far
    sfxVol: 0.35
    operatorOnly: 0
    dark: -1
    bgm: 
    bg: -1
