    text: "\uD544\uB9AC\uD540. \uD574\uB9C8\uB2E4 \uD0DC\uD48D\uC774 \uC2A4\uBB34
      \uAC1C \uAC00\uAE4C\uC774 \uC9C0\uB098\uAC00\uB294 '\uD0DC\uD48D\uC758 \uAE38\uBAA9'\uC774\uB2E4.
      \uC6B0\uAE30\uAC00 \uC624\uBA74 \uC774 \uB098\uB77C\uB294 \uAC19\uC740 \uD53C\uD574\uB97C
      \uB418\uD480\uC774\uD574\uC11C \uACAA\uB294\uB2E4."
    kind: 1
    portrait: -1
    note: 
    focus: -1
    chatter: 0
    chapter: "Stage 1 \xB7 BAYANI CAMP"
    chapterSub: "\uD544\uB9AC\uD540 \xB7 \uAD6D\uC81C \uCCAD\uC18C\uB144 \uAD50\uB958
      \uCEA0\uD504, \uCCAB\uC9F8 \uB0A0"
    ambience: 
    ambVol: 0.3
    sfx: 
    sfxVol: 0.8
    operatorOnly: 0
    dark: -1
    bgm: 
    bg: 0
  - speaker: 
    text: "\uADF8\uB9AC\uACE0 \uC624\uB298\uC740 \uAD6D\uC81C \uCCAD\uC18C\uB144
      \uAD50\uB958 \uCEA0\uD504\uC758 \uCCAB\uB0A0. \uB3C4\uC724\uC744 \uD0DC\uC6B4
      \uBC84\uC2A4\uAC00 BAYANI CAMP \uC55E\uC5D0 \uCC9C\uCC9C\uD788 \uBA48\uCDB0
      \uC120\uB2E4."
    kind: 1
    portrait: -1
    note: 
    focus: -1
    chatter: 0
    chapter: 
    chapterSub: 
    ambience: 
    ambVol: 0.3
    sfx: 
    sfxVol: 0.8
    operatorOnly: 0
    dark: -1
    bgm: 
    bg: -1
  - speaker: 
    text: "\uCE58\uC774\uC775\u2014 \uBC84\uC2A4 \uBB38\uC774 \uC5F4\uB9B0\uB2E4.
      \uD6C4\uB048\uD55C \uACF5\uAE30\uAC00 \uD6C5 \uB07C\uCCD0 \uC628\uB2E4."
    kind: 1
    portrait: -1
    note: 
    focus: -1
    chatter: 0
    chapter: 
    chapterSub: 
    ambience: 
    ambVol: 0.3
    sfx: bus_arrive
    sfxVol: 0.5
    operatorOnly: 0
    dark: -1
    bgm: 
    bg: -1
  - speaker: "\uB3C4\uC724"
    text: "\uC640\u2026 \uC9C4\uC9DC \uC678\uAD6D\uC774\uB2E4. \uACF5\uAE30\uBD80\uD130
      \uB2E4\uB974\uB124. \uB365\uACE0, \uC2B5\uD558\uACE0, \uB098\uBB34\uB294 \uC5C4\uCCAD
      \uD06C\uACE0."
    kind: 2
    portrait: 0
    note: 
    focus: -1
    chatter: 0
    chapter: 
    chapterSub: 
    ambience: 
    ambVol: 0.3
    sfx: 
    sfxVol: 0.8
    operatorOnly: 0
    dark: -1
    bgm: 
    bg: -1
  - speaker: "\uB3C4\uC724"
    text: "\uB0B4\uAC00 \uB300\uD45C\uB85C \uBF51\uD78C \uAC70\uB2C8\uAE4C \uCC98\uC74C\uBD80\uD130
      \uC798\uD574\uC57C\uC9C0. \uC5B4\uAE68 \uD3B4\uACE0, \uC6C3\uC73C\uBA74\uC11C."
    kind: 2
    portrait: 0
    note: 
    focus: -1
    chatter: 0
    chapter: 
    chapterSub: 
    ambience: 
    ambVol: 0.3
    sfx: 
    sfxVol: 0.8
    operatorOnly: 0
    dark: -1
    bgm: 
    bg: -1
  - speaker: 
    text: "\uB3C4\uC724\uC740 \uCE90\uB9AC\uC5B4\uB97C \uB04C\uACE0 \uBC84\uC2A4\uC5D0\uC11C
      \uB0B4\uB9B0\uB2E4. \uBCF8\uAD00 \uC785\uAD6C\uC758 \uD604\uC218\uB9C9\uC5D0\uB294
      'Together for a Brighter Tomorrow' \uB77C\uACE0 \uC801\uD600 \uC788\uB2E4.
      \uADF8 \uC544\uB798, \uC138 \uBA85\uC774 \uB3C4\uC724\uC744 \uD5A5\uD574 \uC190\uC744
      \uD754\uB4E4\uACE0 \uC788\uB2E4."
    kind: 1
    portrait: -1
    note: 
    focus: -1
    chatter: 0
    chapter: 
    chapterSub: 
    ambience: 
    ambVol: 0.3
    sfx: 
    sfxVol: 0.8
    operatorOnly: 0
    dark: -1
    bgm: 
    bg: -1
  - speaker: "\uB9C8\uB9AC\uC544"
    text: Kumusta! Maligayang pagdating!
    kind: 0
    portrait: 1
    note: "\uD658\uD558\uAC8C \uC190\uC744 \uD754\uB4E4\uBA70"
    focus: -1
    chatter: 0
    chapter: 
    chapterSub: 
    ambience: 
    ambVol: 0.3
    sfx: 
    sfxVol: 0.8
    operatorOnly: 0
    dark: -1
    bgm: 
    bg: -1
  - speaker: "\uB3C4\uC724"
    text: "\u2026\uBB34\uC2A8 \uB9D0\uC774\uC9C0? \uC601\uC5B4\uB294 \uC544\uB2CC\uB370.
      \uC77C\uB2E8 \uC6C3\uC790."
    kind: 2
    portrait: 0
    note: 
    focus: -1
    chatter: 0
    chapter: 
    chapterSub: 
    ambience: 
    ambVol: 0.3
    sfx: 
    sfxVol: 0.8
    operatorOnly: 0
    dark: -1
    bgm: 
    bg: -1
  - speaker: "\uB3C4\uC724"
    text: "\uC544, \uC548\uB155! \uB098\uB294 \uB3C4\uC724\uC774\uC57C. \uD55C\uAD6D\uC5D0\uC11C
      \uC654\uC5B4!"
    kind: 0
    portrait: 0
    note: "\uC790\uAE30 \uAC00\uC2B4\uC744 \uD1A1\uD1A1 \uCE58\uBA70, \uB610\uBC15\uB610\uBC15"
    focus: -1
    chatter: 0
    chapter: 
    chapterSub: 
    ambience: 
    ambVol: 0.3
    sfx: 
    sfxVol: 0.8
    operatorOnly: 0
    dark: -1
    bgm: 
    bg: -1
  - speaker: 
    text: "\uB9C8\uB9AC\uC544\uAC00 \uACE0\uAC1C\uB97C \uAC38\uC6C3\uD55C\uB2E4.
      \uB3C4\uC724\uC740 \uD55C \uBC88 \uB354, \uB354 \uCC9C\uCC9C\uD788, \uB354
      \uD06C\uAC8C \uB9D0\uD55C\uB2E4."
    kind: 1
    portrait: -1
    note: 
    focus: -1
    chatter: 0
    chapter: 
    chapterSub: 
