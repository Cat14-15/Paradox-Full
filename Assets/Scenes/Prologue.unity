  - speaker: "\uB2F4\uC784 \uC120\uC0DD\uB2D8"
    text: "\uADF8\uB798. \uC120\uC0DD\uB2D8\uB4E4 \uC0AC\uC774\uC5D0\uC11C \uB124\uAC00
      \uCE5C\uAD6C\uB4E4\uC744 \uC798 \uC774\uB048\uB2E4\uACE0 \uB9D0\uC774 \uB9CE\uB354\uB77C.
      \uC774\uBC88 \uC870\uBCC4 \uACFC\uC81C\uB3C4 \uB124\uAC00 \uC798 \uB9E1\uC558\uACE0."
    kind: 0
    portrait: 4
    note: 
    focus: -1
    chatter: 0
    chapter: 
    chapterSub: 
    ambience: 
    ambVol: 0.3
    sfx: 
    sfxVol: 0.8
    operatorOnly: 0
    dark: -1
    bgm: 
    bg: -1
  - speaker: "\uB2F4\uC784 \uC120\uC0DD\uB2D8"
    text: "\uC5EC\uB7EC \uB098\uB77C \uCE5C\uAD6C\uB4E4\uC774\uB791 \uD55C \uD300\uC774
      \uB420 \uAC70\uC57C. \uB9D0\uB3C4 \uBB38\uD654\uB3C4 \uB2E4\uB974\uB2C8\uAE4C
      \uC27D\uC9C0\uB294 \uC54A\uACA0\uC9C0\uB9CC, \uB124\uAC00 \uC798 \uD574\uB0BC
      \uAC70\uB77C\uACE0 \uBBFF\uB294\uB2E4."
    kind: 0
    portrait: 4
    note: 
    focus: -1
    chatter: 0
    chapter: 
    chapterSub: 
    ambience: 
    ambVol: 0.3
    sfx: 
    sfxVol: 0.8
    operatorOnly: 0
    dark: -1
    bgm: 
    bg: -1
  - speaker: "\uB3C4\uC724"
    text: "\uC6B0\uC640, \uC678\uAD6D \uCE5C\uAD6C\uB4E4\uC774\uB791\uC694? \uC7AC\uBC0C\uACA0\uB2E4!
      \uC5F4\uC2EC\uD788 \uD574 \uBCFC\uAC8C\uC694, \uC120\uC0DD\uB2D8."
    kind: 0
    portrait: 0
    note: "\uD65C\uC9DD \uC6C3\uC73C\uBA70"
    focus: 2
    chatter: 0
    chapter: 
    chapterSub: 
    ambience: 
    ambVol: 0.3
    sfx: 
    sfxVol: 0.8
    operatorOnly: 0
    dark: -1
    bgm: 
    bg: -1
  - speaker: "\uB2F4\uC784 \uC120\uC0DD\uB2D8"
    text: "\uADF8\uB798, \uC900\uBE44 \uC798\uD558\uACE0. \uCD9C\uBC1C\uD558\uAE30
      \uC804\uC5D0 \uB2E4\uC2DC \uC548\uB0B4\uD574 \uC904\uAC8C. \uC870\uC2EC\uD788
      \uB4E4\uC5B4\uAC00\uB834."
    kind: 0
    portrait: 4
    note: 
    focus: -1
    chatter: 0
    chapter: 
    chapterSub: 
    ambience: 
    ambVol: 0.3
    sfx: 
    sfxVol: 0.8
    operatorOnly: 0
    dark: -1
    bgm: 
    bg: -1
  - speaker: 
    text: "\uC120\uC0DD\uB2D8\uC774 \uB3CC\uC544\uAC00\uACE0, \uC2E0\uD638\uB4F1\uC774
      \uCD08\uB85D\uC0C9\uC73C\uB85C \uBC14\uB010\uB2E4. \uB3C4\uC724\uC740 \uC2E0\uC774
      \uB098\uC11C \uAC00\uBC29\uB048\uC744 \uACE0\uCCD0 \uBA54\uACE0 \uD6A1\uB2E8\uBCF4\uB3C4\uB97C
      \uAC74\uB10C\uB2E4."
    kind: 1
    portrait: -1
    note: 
    focus: -1
    chatter: 0
    chapter: 
    chapterSub: 
    ambience: 
    ambVol: 0.3
    sfx: 
    sfxVol: 0.8
    operatorOnly: 0
    dark: -1
    bgm: 
    bg: -1
  - speaker: "\uB3C4\uC724"
    text: "\uC678\uAD6D\uC778 \uCE5C\uAD6C\uB4E4\uC774\uB791 \uD300\uC774 \uB41C\uB2E4\uACE0?
      \uBB50, \uB9D0\uC740 \uC548 \uD1B5\uD574\uB3C4 \uB0B4\uAC00 \uC798 \uCC59\uACA8\uC8FC\uBA74
      \uB418\uACA0\uC9C0."
    kind: 2
    portrait: 0
    note: 
    focus: 2
    chatter: 0
    chapter: 
    chapterSub: 
    ambience: 
    ambVol: 0.3
    sfx: 
    sfxVol: 0.8
    operatorOnly: 0
    dark: -1
    bgm: 
    bg: -1
  - speaker: 
    text: "\uB178\uC744\uC774 \uCC9C\uCC9C\uD788 \uB0B4\uB824\uC549\uB294\uB2E4.
      \uB3C4\uC724\uC758 \uBC1C\uAC78\uC74C\uC740, \uAC00\uBCCD\uB2E4."
