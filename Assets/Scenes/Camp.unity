  - speaker: "\uB3C4\uC724"
    text: "\uB9C8\uB9AC\uC544? \uC65C \uADF8\uB798? \uD558\uB298\uC5D0 \uBB50 \uC788\uC5B4?"
    kind: 0
    portrait: 0
