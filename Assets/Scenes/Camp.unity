    bg: -1
  - speaker: "\uB9C8\uB9AC\uC544"
    text: "Doyoon? \u2026Doyoon!"
    kind: 0
    portrait: 1
    note: "\uB208\uC774 \uCEE4\uC9C0\uBA70"
    focus: -1
    chatter: 0
