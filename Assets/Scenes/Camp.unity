    chapterSub: 
    ambience: 
    ambVol: 0.3
    sfx: 
    sfxVol: 0.8
    operatorOnly: 0
    dark: -1
    bgm: 
    bg: -1
  - speaker: 
    text: "\uC544\uC774\uC0E4\uAC00 \uC190\uC744 \uBC88\uCA4D \uB4E4\uC5B4 \uD558\uC774\uD30C\uC774\uBE0C\uB97C
      \uCCAD\uD55C\uB2E4. \uB3C4\uC724\uC774 \uB9C8\uC8FC \uCE58\uC790, \uC9DD! \uD558\uACE0
      \uACBD\uCF8C\uD55C \uC18C\uB9AC\uAC00 \uB09C\uB2E4. \uB9B0\uC740 \uB450 \uC190\uC744
      \uBAA8\uC73C\uACE0 \uAC00\uBCCD\uAC8C \uACE0\uAC1C\uB97C \uC219\uC778\uB2E4."
    kind: 1
    portrait: -1
    note: 
    focus: -1
    chatter: 0
    chapter: 
    chapterSub: 
    ambience: 
    ambVol: 0.3
    sfx: 
    sfxVol: 0.8
    operatorOnly: 0
    dark: -1
    bgm: 
    bg: -1
  - speaker: "\uB3C4\uC724"
    text: "\uC190\uC9D3\uC774\uB791 \uD45C\uC815\uC73C\uB85C\uB294 \uC5BC\uCD94 \uD1B5\uD558\uB124.
      \uC774 \uC815\uB3C4\uBA74 \uD560 \uB9CC\uD55C\uB370?"
