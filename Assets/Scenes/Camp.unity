  - speaker: "\uC544\uC774\uC0E4"
    text: Sawubona! Aisha! I am Aisha!
    kind: 0
    portrait: 3
    note: "\uB450 \uD314\uC744 \uD06C\uAC8C \uD754\uB4E4\uBA70"
    focus: -1
    chatter: 0
