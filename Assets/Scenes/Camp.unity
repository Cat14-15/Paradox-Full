  - speaker: 
    text: "\uC544\uC774\uC0E4\uB294 \uC870\uAC01\uC0C1 \uC55E\uC5D0\uC11C \uC0AC\uC9C4
      \uCC0D\uB294 \uC2DC\uB289\uC744 \uD558\uACE0, \uB9B0\uC740 \uBCBD\uC758 \uC548\uB0B4\uBB38\uC744
      \uC0B4\uD540\uB2E4. \uB9C8\uB9AC\uC544\uB9CC \uC790\uAFB8 \uCC3D\uBC16\uC744
      \uC62C\uB824\uB2E4\uBCF8\uB2E4."
