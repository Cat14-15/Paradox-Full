    bg: -1
  - speaker: "\uB3C4\uC724"
    text: "\uC774\uB984\uC740 \uC54C\uC544\uB4E3\uACA0\uB294\uB370\u2026 \uB4A4\uB294
      \uD558\uB098\uB3C4 \uBAA8\uB974\uACA0\uB2E4."
