  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: edfa5265b448a024181d94884adef4c0, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Paradox::Paradox.Client.PrologueScene
  black: {fileID: 640614161}
  sils:
  - {fileID: 460951222}
  - {fileID: 1563503371}
  - {fileID: 1035978677}
  - {fileID: 1801197349}
  - {fileID: 969926714}
  marker: {fileID: 0}
  dialogue: {fileID: 415842575}
  dialogueGroup: {fileID: 415842574}
  portrait: {fileID: 1915161628}
  portraitRect: {fileID: 1915161626}
  portraitSprites:
  - {fileID: 21300000, guid: 8b2a4f1d901f4678b24c32ea48b1088c, type: 3}
  - {fileID: 21300000, guid: 8cc321e955b661947a1838b4ac9d77e5, type: 3}
  - {fileID: 21300000, guid: 499b64a34ca650e4a803d201e5db4235, type: 3}
  - {fileID: 21300000, guid: c4e772e12915c6241a718a4544c6b38d, type: 3}
  - {fileID: 21300000, guid: 035885b1e72247c4abc37957912c78f6, type: 3}
  nameText: {fileID: 1720046865}
  tagText: {fileID: 977437691}
  bodyText: {fileID: 1799741193}
  nextMark: {fileID: 695762840}
  crowd: {fileID: 434196657}
  waitText: {fileID: 581704317}
  nameRect: {fileID: 1720046863}
  bgImage: {fileID: 1115213768}
  bgSprites:
  - {fileID: 21300000, guid: 3c077a7e199a2474e9357bbfff8ecb65, type: 3}
  - {fileID: 21300000, guid: b23cc1836b68e4f4687c1538020182f5, type: 3}
  - {fileID: 21300000, guid: bf68c871427261e4a926b93cbb65a756, type: 3}
  titleText: {fileID: 1825864928}
  subText: {fileID: 111943164}
  nextScene: Camp
  isCamp: 0
  startAmbience: cafeteria_crowd
  startAmbVol: 0.28
  bgmTrack: prologue
  lines:
  - speaker: 
    text: "\uD55C\uAD6D\uC758 \uC5B4\uB290 \uC911\uD559\uAD50, \uC810\uC2EC\uC2DC\uAC04.
      \uB3C4\uC724\uC740 \uCE5C\uAD6C\uB4E4\uACFC \uC641\uC790\uC9C0\uAEC4 \uC810\uC2EC\uC744
      \uBA39\uACE0 \uC788\uB2E4. \uBA87 \uC790\uB9AC \uB5A8\uC5B4\uC9C4 \uACF3\uC5D0\uB294
      \uC9C0\uD638\uAC00 \uD63C\uC790 \uC549\uC544 \uC788\uB2E4."
    kind: 1
    portrait: -1
    note: 
    focus: -1
    chatter: 1
    chapter: 
    chapterSub: 
    ambience: 
    ambVol: 0.3
    sfx: 
    sfxVol: 0.8
    bg: -1
  - speaker: "\uCE5C\uAD6C 1"
    text: "\uC57C, \uC9C0\uD638 \uB108 \uD55C\uAD6D\uB9D0 \uC9C4\uC9DC \uC798\uD55C\uB2E4\u314B\u314B
      \uC678\uAD6D\uC778 \uB9DE\uC544?"
    kind: 0
    portrait: 1
    note: 
    focus: 0
    chatter: 0.8
    chapter: 
    chapterSub: 
    ambience: 
    ambVol: 0.3
    sfx: 
    sfxVol: 0.8
    bg: -1
  - speaker: "\uC9C0\uD638"
    text: "\uC5B4\u2026 \uB098 \uD55C\uAD6D\uC5D0\uC11C \uD0DC\uC5B4\uB0AC\uB294\uB370."
    kind: 0
    portrait: 3
    note: "\uC5B4\uC0C9\uD558\uAC8C \uC6C3\uC73C\uBA70"
    focus: 4
    chatter: 0.15
    chapter: 
    chapterSub: 
    ambience: 
    ambVol: 0.3
    sfx: 
    sfxVol: 0.8
    bg: -1
  - speaker: "\uCE5C\uAD6C 2"
    text: "\uADFC\uB370 \uB108\uD76C \uC5C4\uB9C8\uB294 \uC5B4\uB290 \uB098\uB77C
      \uC0AC\uB78C\uC774\uC57C? \uBCA0\uD2B8\uB0A8?"
    kind: 0
    portrait: 2
    note: 
    focus: 1
    chatter: 0.7
    chapter: 
    chapterSub: 
    ambience: 
    ambVol: 0.3
    sfx: 
    sfxVol: 0.8
    bg: -1
  - speaker: "\uC9C0\uD638"
    text: "\uC5B4\u2026 \uC751. \uBCA0\uD2B8\uB0A8 \uBD84\uC774\uC154."
    kind: 0
    portrait: 3
    note: "\uBA38\uBB47\uAC70\uB9AC\uB2E4\uAC00"
    focus: 4
    chatter: 0.15
    chapter: 
    chapterSub: 
    ambience: 
    ambVol: 0.3
    sfx: 
    sfxVol: 0.8
    bg: -1
  - speaker: "\uCE5C\uAD6C 1"
    text: "\uC624, \uC9C4\uC9DC? \uADF8\uB7FC \uBCA0\uD2B8\uB0A8\uC5B4\uB3C4 \uD560
      \uC904 \uC54C\uC544? \uC544\uBB34 \uB9D0\uC774\uB098 \uD574\uBD10!"
    kind: 0
    portrait: 1
    note: 
    focus: 0
    chatter: 0.9
    chapter: 
    chapterSub: 
    ambience: 
    ambVol: 0.3
    sfx: 
    sfxVol: 0.8
    bg: -1
  - speaker: "\uC9C0\uD638"
    text: "\uC544\u2026 \uC9D1\uC5D0\uC11C\uB294 \uC870\uAE08 \uC4F0\uB294\uB370,
      \uC9C0\uAE08\uC740 \uC880\u2026"
    kind: 0
    portrait: 3
    note: "\uB09C\uCC98\uD558\uAC8C \uC6C3\uC73C\uBA70"
    focus: 4
    chatter: 0.1
    chapter: 
    chapterSub: 
    ambience: 
    ambVol: 0.3
    sfx: 
    sfxVol: 0.8
    bg: -1
  - speaker: "\uB3C4\uC724"
    text: "\uC5D0\uC774, \uD55C\uB9C8\uB514\uB9CC! \uB098\uB3C4 \uAD81\uAE08\uD558\uB2E4.
      \uC9C0\uD638\uC57C, \uBCA0\uD2B8\uB0A8\uC5B4\uB85C '\uC548\uB155' \uC774 \uBB50\uC57C?"
    kind: 0
    portrait: 0
    note: 
    focus: 2
    chatter: 1
    chapter: 
    chapterSub: 
    ambience: 
    ambVol: 0.3
    sfx: 
    sfxVol: 0.8
    bg: -1
  - speaker: "\uC9C0\uD638"
    text: "\u2026\uC52C \uC9DC\uC624."
    kind: 0
    portrait: 3
    note: "\uC544\uC8FC \uC791\uC740 \uBAA9\uC18C\uB9AC\uB85C"
    focus: 4
    chatter: 0.1
    chapter: 
    chapterSub: 
    ambience: 
    ambVol: 0.3
    sfx: 
    sfxVol: 0.8
    bg: -1
  - speaker: "\uCE5C\uAD6C 2"
    text: "\uC624~ \uC2E0\uAE30\uD558\uB2E4\u314B\u314B \uB610 \uD574\uBD10, \uB610!"
    kind: 0
    portrait: 2
    note: 
    focus: 1
    chatter: 1
    chapter: 
    chapterSub: 
    ambience: 
    ambVol: 0.3
    sfx: 
    sfxVol: 0.8
    bg: -1
  - speaker: 
    text: "\uB3C4\uC724\uC740 \uBB38\uC81C\uB77C\uACE0 \uB290\uB07C\uC9C0 \uC54A\uACE0,
      \uC6C3\uC73C\uBA70 \uC790\uC5F0\uC2A4\uB7FD\uAC8C \uB300\uD654\uC5D0 \uC11E\uC778\uB2E4."
    kind: 1
    portrait: -1
    note: 
    focus: 2
    chatter: 1
    chapter: 
    chapterSub: 
    ambience: 
    ambVol: 0.3
    sfx: 
    sfxVol: 0.8
    bg: -1
  - speaker: "\uB3C4\uC724"
    text: "\uC5D0\uC774, \uADF8\uB0E5 \uC7A5\uB09C\uC774\uC9C0. \uC9C0\uD638\uB3C4
      \uC6C3\uACE0 \uC788\uC796\uC544."
    kind: 2
    portrait: 0
    note: 
    focus: 2
    chatter: 0.5
    chapter: 
    chapterSub: 
    ambience: 
    ambVol: 0.3
    sfx: 
    sfxVol: 0.8
    bg: -1
  - speaker: 
    text: "\uB2E4\uC74C \uB0A0, \uC0AC\uD68C \uC2DC\uAC04. \uCE60\uD310\uC5D0\uB294
      '\uB2E4\uBB38\uD654 \uC0AC\uD68C, \uC6B0\uB9AC \uC8FC\uBCC0\uC758 \uC774\uC57C\uAE30'\uB77C\uACE0
      \uC801\uD600 \uC788\uB2E4. \uC120\uC0DD\uB2D8\uC774 \uC870\uBCC4 \uACFC\uC81C
      \uC870 \uD3B8\uC131\uD45C\uB97C \uBD99\uC774\uACE0 \uB098\uAC04\uB2E4."
    kind: 1
    portrait: -1
    note: 
    focus: -1
    chatter: 0
    chapter: "\uB2E4\uC74C \uB0A0 \xB7 \uC870\uBCC4 \uACFC\uC81C"
    chapterSub: "\uC0AC\uD68C \uC2DC\uAC04"
    ambience: ambience_classroom
    ambVol: 0.3
    sfx: 
    sfxVol: 0.8
    bg: 1
  - speaker: "\uCE5C\uAD6C 1"
    text: "\uC57C\uC57C, \uC6B0\uB9AC \uC870 \uB204\uAD6C\uC57C? \uB098 \uB3C4\uC724\uC774\uB791
      \uAC19\uC740 \uC870 \uB9DE\uC9C0?"
    kind: 0
    portrait: 1
    note: 
    focus: 0
    chatter: 0
    chapter: 
    chapterSub: 
    ambience: 
    ambVol: 0.3
    sfx: 
    sfxVol: 0.8
    bg: -1
  - speaker: "\uB3C4\uC724"
    text: "\uC5B4\uB514 \uBCF4\uC790\u2026 \uB098, \uB108, \uC7E4, \uADF8\uB9AC\uACE0\u2026
      \uC5B4, \uC9C0\uD638\uB3C4 \uC6B0\uB9AC \uC870\uB124."
    kind: 0
    portrait: 0
    note: "\uBA85\uB2E8\uC744 \uD6D1\uC5B4\uBCF4\uB2E4\uAC00"
    focus: 2
    chatter: 0
    chapter: 
    chapterSub: 
    ambience: 
    ambVol: 0.3
    sfx: 
    sfxVol: 0.8
    bg: -1
  - speaker: "\uCE5C\uAD6C 2"
    text: "\uC624, \uC9C0\uD638 \uC6B0\uB9AC \uC870\uC57C? \uC798\uB410\uB2E4. \uC774\uBC88
      \uC8FC\uC81C \uC644\uC804 \uB108 \uC598\uAE30\uB124\u314B\u314B"
    kind: 0
    portrait: 2
    note: 
    focus: 1
    chatter: 0
    chapter: 
    chapterSub: 
    ambience: 
    ambVol: 0.3
    sfx: 
    sfxVol: 0.8
    bg: -1
  - speaker: "\uC9C0\uD638"
    text: "\uC5B4\u2026 \uC798 \uBD80\uD0C1\uD574."
    kind: 0
    portrait: 3
    note: "\uC870\uC2EC\uC2A4\uB7FD\uAC8C"
    focus: 4
    chatter: 0
    chapter: 
    chapterSub: 
    ambience: 
    ambVol: 0.3
    sfx: 
    sfxVol: 0.8
    bg: -1
  - speaker: "\uB3C4\uC724"
    text: "\uC5B4, \uC5B4. \uC798 \uBD80\uD0C1\uD574."
    kind: 0
    portrait: 0
    note: "\uC7A0\uAE50 \uBA38\uBB47\uAC70\uB9AC\uB2E4\uAC00"
    focus: 2
    chatter: 0
    chapter: 
    chapterSub: 
    ambience: 
    ambVol: 0.3
    sfx: 
    sfxVol: 0.8
    bg: -1
  - speaker: "\uCE5C\uAD6C 1"
    text: "\uBC1C\uD45C\uB294 \uB204\uAC00 \uD574? \uC9C0\uD638 \uB124\uAC00 \uD574\uB3C4
      \uB418\uACA0\uB2E4. \uBCA0\uD2B8\uB0A8 \uC598\uAE30 \uD558\uBA74 \uB531\uC774\uC796\uC544."
    kind: 0
    portrait: 1
    note: 
    focus: 0
    chatter: 0
    chapter: 
    chapterSub: 
    ambience: 
    ambVol: 0.3
    sfx: 
    sfxVol: 0.8
    bg: -1
  - speaker: "\uC9C0\uD638"
    text: "\uB098\uB294\u2026 \uC0AC\uC2E4 \uBCA0\uD2B8\uB0A8\uC5D0 \uAC00 \uBCF8
      \uC801\uB3C4 \uBCC4\uB85C \uC5C6\uC5B4\uC11C. \uC798 \uBAA8\uB974\uB294\uB370\u2026"
    kind: 0
    portrait: 3
    note: "\uBA38\uC4F1\uD558\uAC8C"
    focus: 4
    chatter: 0
    chapter: 
    chapterSub: 
    ambience: 
    ambVol: 0.3
    sfx: 
    sfxVol: 0.8
    bg: -1
  - speaker: "\uB3C4\uC724"
    text: "\uC544, \uADF8\uB7FC \uBC1C\uD45C\uB294 \uB0B4\uAC00 \uD560\uAC8C. \uB0B4\uAC00
      \uB9D0\uD558\uB294 \uAC74 \uC880 \uC798\uD558\uC796\uC544."
    kind: 0
    portrait: 0
    note: "\uC6C3\uC73C\uBA70"
    focus: 2
    chatter: 0
    chapter: 
    chapterSub: 
    ambience: 
    ambVol: 0.3
    sfx: 
    sfxVol: 0.8
    bg: -1
  - speaker: "\uCE5C\uAD6C 2"
    text: "\uB9DE\uB124, \uB3C4\uC724\uC544 \uB108\uAC00 \uD558\uBA74 \uB418\uACA0\uB124."
    kind: 0
    portrait: 2
    note: 
    focus: 1
    chatter: 0
    chapter: 
    chapterSub: 
    ambience: 
    ambVol: 0.3
    sfx: 
    sfxVol: 0.8
    bg: -1
  - speaker: "\uC9C0\uD638"
    text: "\uC800\uAE30\u2026 \uB098\uB3C4 \uD558\uACE0 \uC2F6\uC740 \uBD80\uBD84\uC774
      \uC788\uB294\uB370\u2026"
    kind: 0
    portrait: 3
    note: "\uC544\uC8FC \uC791\uC740 \uBAA9\uC18C\uB9AC\uB85C"
    focus: 4
    chatter: 0
    chapter: 
    chapterSub: 
    ambience: 
    ambVol: 0.3
    sfx: 
    sfxVol: 0.8
    bg: -1
  - speaker: "\uB3C4\uC724"
    text: "\uC544, \uAD1C\uCC2E\uC544 \uAD1C\uCC2E\uC544. \uB10C \uADF8\uB0E5\u2026
      \uC790\uB8CC\uB9CC \uC815\uB9AC\uD574 \uC904\uB798? \uBC1C\uD45C\uB294 \uB0B4\uAC00
      \uD560\uAC8C."
    kind: 0
    portrait: 0
    note: "\uC774\uBBF8 \uB178\uD2B8\uB97C \uD3B4\uBA70"
    focus: 2
    chatter: 0
    chapter: 
    chapterSub: 
    ambience: 
    ambVol: 0.3
    sfx: 
    sfxVol: 0.8
    bg: -1
  - speaker: "\uC9C0\uD638"
    text: "\u2026\uC751. \uC54C\uACA0\uC5B4."
    kind: 0
    portrait: 3
    note: "\uC7A0\uC2DC \uB9D0\uC774 \uC5C6\uB2E4\uAC00"
    focus: 4
    chatter: 0
    chapter: 
    chapterSub: 
    ambience: 
    ambVol: 0.3
    sfx: 
    sfxVol: 0.8
    bg: -1
  - speaker: 
    text: "\uC9C0\uD638\uB294 \uACE0\uAC1C\uB97C \uB044\uB355\uC778\uB2E4. \uC544\uC8FC
      \uC7A0\uAE50, \uD45C\uC815\uC5D0 \uC605\uC740 \uC2E4\uB9DD\uC774 \uC2A4\uCE5C\uB2E4."
    kind: 1
    portrait: -1
    note: 
    focus: -1
    chatter: 0
    chapter: 
    chapterSub: 
    ambience: 
    ambVol: 0.3
    sfx: 
    sfxVol: 0.8
    bg: -1
  - speaker: "\uB3C4\uC724"
    text: "\uBC1C\uD45C\uB294 \uB0B4\uAC00 \uD558\uB294 \uAC8C \uB0AB\uC9C0. \uAD1C\uD788
      \uB9E1\uACBC\uB2E4\uAC00 \uC9C0\uD638\uAC00 \uBD80\uB2F4\uC2A4\uB7EC\uC6CC\uD560
      \uC218\uB3C4 \uC788\uACE0."
    kind: 2
    portrait: 0
    note: 
    focus: 2
    chatter: 0
    chapter: 
    chapterSub: 
    ambience: 
    ambVol: 0.3
    sfx: 
    sfxVol: 0.8
    bg: -1
  - speaker: "\uCE5C\uAD6C 1"
    text: "\uB3C4\uC724\uC544, \uB05D\uB098\uACE0 PC\uBC29 \uAC08 \uAC70\uC9C0?"
    kind: 0
    portrait: 1
    note: 
    focus: 0
    chatter: 0
    chapter: 
    chapterSub: 
    ambience: 
    ambVol: 0.3
    sfx: 
    sfxVol: 0.8
    bg: -1
  - speaker: "\uB3C4\uC724"
    text: "\uB2F9\uC5F0\uD558\uC9C0! \uBA3C\uC800 \uAC00 \uC788\uC5B4, \uAE08\uBC29
      \uAC08\uAC8C."
    kind: 0
    portrait: 0
    note: 
    focus: 2
    chatter: 0
    chapter: 
    chapterSub: 
    ambience: 
    ambVol: 0.3
    sfx: 
    sfxVol: 0.8
    bg: -1
  - speaker: 
    text: "\uC885\uC774 \uC6B8\uB9AC\uC790 \uC544\uC774\uB4E4\uC740 \uC6B0\uB974\uB974
      \uAD50\uC2E4\uC744 \uBE60\uC838\uB098\uAC04\uB2E4. \uC9C0\uD638\uB294 \uD63C\uC790
      \uB0A8\uC544, \uC870\uC6A9\uD788 \uC790\uB8CC\uB97C \uC815\uB9AC\uD558\uAE30
      \uC2DC\uC791\uD55C\uB2E4."
    kind: 1
    portrait: -1
    note: 
    focus: -1
    chatter: 0
    chapter: 
    chapterSub: 
    ambience: 
    ambVol: 0.3
    sfx: school_bell
    sfxVol: 0.7
    bg: -1
  - speaker: 
    text: "\uBA70\uCE60 \uB4A4, \uD558\uAD63\uAE38. \uB3C4\uC724\uC740 \uCE5C\uAD6C\uB4E4\uACFC
      \uD5E4\uC5B4\uC838 \uD63C\uC790 \uAD50\uBB38\uC744 \uB098\uC120\uB2E4. \uD6A1\uB2E8\uBCF4\uB3C4
      \uC55E\uC5D0\uC11C \uC2E0\uD638\uAC00 \uBC14\uB00C\uAE30\uB97C \uAE30\uB2E4\uB9AC\uB294\uB370,
      \uB4A4\uC5D0\uC11C \uB204\uAD70\uAC00 \uB3C4\uC724\uC744 \uBD80\uB978\uB2E4."
    kind: 1
    portrait: -1
    note: 
    focus: -1
    chatter: 0
    chapter: "\uBA70\uCE60 \uD6C4 \xB7 \uD558\uAD63\uAE38"
    chapterSub: "\uD559\uAD50 \uC55E \uD6A1\uB2E8\uBCF4\uB3C4"
    ambience: ambience_street
    ambVol: 0.3
    sfx: 
    sfxVol: 0.8
    bg: 2
  - speaker: "\uB2F4\uC784 \uC120\uC0DD\uB2D8"
    text: "\uB3C4\uC724\uC544! \uC7A0\uAE50\uB9CC \uAE30\uB2E4\uB824 \uBD10."
    kind: 0
    portrait: 4
    note: 
    focus: -1
    chatter: 0
    chapter: 
    chapterSub: 
    ambience: 
    ambVol: 0.3
    sfx: 
    sfxVol: 0.8
    bg: -1
  - speaker: "\uB3C4\uC724"
    text: "\uC5B4, \uC120\uC0DD\uB2D8. \uBB34\uC2A8 \uC77C\uC774\uC138\uC694?"
    kind: 0
    portrait: 0
    note: 
    focus: 2
    chatter: 0
    chapter: 
    chapterSub: 
    ambience: 
    ambVol: 0.3
    sfx: 
    sfxVol: 0.8
    bg: -1
  - speaker: "\uB2F4\uC784 \uC120\uC0DD\uB2D8"
    text: "\uC88B\uC740 \uC18C\uC2DD\uC774 \uC788\uC5B4\uC11C. \uC774\uBC88\uC5D0
      \uAD6D\uC81C \uCCAD\uC18C\uB144 \uAD50\uB958 \uCEA0\uD504 \uB300\uD45C\uB85C
      \uB124\uAC00 \uBF51\uD614\uC5B4."
    kind: 0
    portrait: 4
    note: 
    focus: -1
    chatter: 0
    chapter: 
    chapterSub: 
    ambience: 
    ambVol: 0.3
    sfx: 
    sfxVol: 0.8
    bg: -1
  - speaker: "\uB3C4\uC724"
    text: "\uB124? \uC81C\uAC00\uC694?"
    kind: 0
    portrait: 0
    note: "\uB180\uB77C\uC11C"
    focus: 2
    chatter: 0
    chapter: 
    chapterSub: 
    ambience: 
    ambVol: 0.3
    sfx: 
    sfxVol: 0.8
    bg: -1
  - speaker: "\uB2F4\uC784 \uC120\uC0DD\uB2D8"
    text: "\uADF8\uB798. \uC120\uC0DD\uB2D8\uB4E4 \uC0AC\uC774\uC5D0\uC11C \uB124\uAC00
      \uCE5C\uAD6C\uB4E4\uC744 \uC798 \uC774\uB048\uB2E4\uACE0 \uB9D0\uC774 \uB9CE\uB354\uB77C.
      \uC774\uBC88 \uC870\uBCC4 \uACFC\uC81C\uB3C4 \uB124\uAC00 \uC798 \uB9E1\uC558\uACE0."
    kind: 0
    portrait: 4
    note: 
    focus: -1
    chatter: 0
    chapter: 
    chapterSub: 
    ambience: 
    ambVol: 0.3
    sfx: 
    sfxVol: 0.8
    bg: -1
  - speaker: "\uB2F4\uC784 \uC120\uC0DD\uB2D8"
    text: "\uC5EC\uB7EC \uB098\uB77C \uCE5C\uAD6C\uB4E4\uC774\uB791 \uD55C \uD300\uC774
      \uB420 \uAC70\uC57C. \uB9D0\uB3C4 \uBB38\uD654\uB3C4 \uB2E4\uB974\uB2C8\uAE4C
      \uC27D\uC9C0\uB294 \uC54A\uACA0\uC9C0\uB9CC, \uB124\uAC00 \uC798 \uD574\uB0BC
      \uAC70\uB77C\uACE0 \uBBFF\uB294\uB2E4."
    kind: 0
    portrait: 4
    note: 
    focus: -1
    chatter: 0
    chapter: 
    chapterSub: 
    ambience: 
    ambVol: 0.3
    sfx: 
    sfxVol: 0.8
    bg: -1
  - speaker: "\uB3C4\uC724"
    text: "\uC6B0\uC640, \uC678\uAD6D \uCE5C\uAD6C\uB4E4\uC774\uB791\uC694? \uC7AC\uBC0C\uACA0\uB2E4!
      \uC5F4\uC2EC\uD788 \uD574 \uBCFC\uAC8C\uC694, \uC120\uC0DD\uB2D8."
    kind: 0
    portrait: 0
    note: "\uD65C\uC9DD \uC6C3\uC73C\uBA70"
    focus: 2
    chatter: 0
    chapter: 
    chapterSub: 
    ambience: 
    ambVol: 0.3
    sfx: 
    sfxVol: 0.8
    bg: -1
  - speaker: "\uB2F4\uC784 \uC120\uC0DD\uB2D8"
    text: "\uADF8\uB798, \uC900\uBE44 \uC798\uD558\uACE0. \uCD9C\uBC1C\uD558\uAE30
      \uC804\uC5D0 \uB2E4\uC2DC \uC548\uB0B4\uD574 \uC904\uAC8C. \uC870\uC2EC\uD788
      \uB4E4\uC5B4\uAC00\uB834."
    kind: 0
    portrait: 4
    note: 
    focus: -1
    chatter: 0
    chapter: 
    chapterSub: 
    ambience: 
    ambVol: 0.3
    sfx: 
    sfxVol: 0.8
    bg: -1
  - speaker: 
    text: "\uC120\uC0DD\uB2D8\uC774 \uB3CC\uC544\uAC00\uACE0, \uC2E0\uD638\uB4F1\uC774
      \uCD08\uB85D\uC0C9\uC73C\uB85C \uBC14\uB010\uB2E4. \uB3C4\uC724\uC740 \uC2E0\uC774
      \uB098\uC11C \uAC00\uBC29\uB048\uC744 \uACE0\uCCD0 \uBA54\uACE0 \uD6A1\uB2E8\uBCF4\uB3C4\uB97C
      \uAC74\uB10C\uB2E4."
    kind: 1
    portrait: -1
    note: 
    focus: -1
    chatter: 0
    chapter: 
    chapterSub: 
    ambience: 
    ambVol: 0.3
    sfx: 
    sfxVol: 0.8
    bg: -1
  - speaker: "\uB3C4\uC724"
    text: "\uC678\uAD6D\uC778 \uCE5C\uAD6C\uB4E4\uC774\uB791 \uD300\uC774 \uB41C\uB2E4\uACE0?
      \uBB50, \uB9D0\uC740 \uC548 \uD1B5\uD574\uB3C4 \uB0B4\uAC00 \uC798 \uCC59\uACA8\uC8FC\uBA74
      \uB418\uACA0\uC9C0."
    kind: 2
    portrait: 0
    note: 
    focus: 2
    chatter: 0
    chapter: 
    chapterSub: 
    ambience: 
    ambVol: 0.3
    sfx: 
    sfxVol: 0.8
    bg: -1
  - speaker: 
    text: "\uB178\uC744\uC774 \uCC9C\uCC9C\uD788 \uB0B4\uB824\uC549\uB294\uB2E4.
      \uB3C4\uC724\uC758 \uBC1C\uAC78\uC74C\uC740, \uAC00\uBCCD\uB2E4."
    kind: 1
    portrait: -1
    note: 
    focus: -1
    chatter: 0
    chapter: 
    chapterSub: 
    ambience: 
    ambVol: 0.3
    sfx: 
    sfxVol: 0.8
    bg: -1
