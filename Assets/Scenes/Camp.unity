  - speaker: 
    text: "\uADF8\uB54C, \uC57C\uC790\uC218 \uC78E\uC774 \uD06C\uAC8C \uD754\uB4E4\uB9B0\uB2E4.
      \uD558\uB298 \uD55C\uCABD\uC774 \uC5B4\uB290\uC0C8 \uC7BF\uBE5B\uC774\uB2E4.
      \uB9C8\uB9AC\uC544\uAC00 \uADF8\uCABD\uC744 \uD55C\uCC38 \uC62C\uB824\uB2E4\uBCF8\uB2E4."
