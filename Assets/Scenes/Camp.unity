  - speaker: "\uB3C4\uC724"
    text: "\uB3C4-\uC724. \uB3C4\uC724!"
    kind: 0
    portrait: 0
    note: "\uD070 \uC18C\uB9AC\uB85C"
    focus: -1
    chatter: 0
    chapter: 
    chapterSub: 
    ambience: 
    ambVol: 0.3
    sfx: 
    sfxVol: 0.8
    operatorOnly: 0
