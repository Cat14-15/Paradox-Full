    bg: -1
  - speaker: "\uB3C4\uC724"
    text: "\uC544, \uAD1C\uCC2E\uC544 \uAD1C\uCC2E\uC544! \uB0B4\uAC00 \uB4E4 \uC218
      \uC788\uC5B4!"
    kind: 0
    portrait: 0
    note: "\uC190\uC744 \uD718\uD718 \uC800\uC73C\uBA70"
    focus: -1
    chatter: 0
    chapter: 
    chapterSub: 
    ambience: 
    ambVol: 0.3
    sfx: 
    sfxVol: 0.8
    operatorOnly: 0
    dark: -1
    bgm: 
    bg: -1
  - speaker: 
    text: "\uB9C8\uB9AC\uC544\uB294 \uBA48\uCE6B\uD558\uB2E4\uAC00 \uC6C3\uC73C\uBA70
      \uBB3C\uB7EC\uC120\uB2E4. \uC774\uBC88\uC5D0\uB294 \uB9B0\uC774 \uB3C4\uC724\uC758
      \uBB3C\uBCD1\uC744 \uAC00\uB9AC\uD0A4\uACE0, \uC544\uC774\uC0E4\uAC00 \uBCF8\uAD00\uC744
      \uAC00\uB9AC\uD0A8\uB2E4. \uC138 \uC0AC\uB78C\uC774 \uC790\uAE30 \uB9D0\uB85C
      \uD55C\uAEBC\uBC88\uC5D0 \uB9D0\uC744 \uAC78\uC5B4 \uC624\uC9C0\uB9CC, \uB3C4\uC724\uC5D0\uAC8C\uB294
      \uC5B4\uB290 \uAC83\uB3C4 \uB9D0\uC774 \uB418\uC9C0 \uC54A\uB294\uB2E4."
    kind: 1
    portrait: -1
    note: 
    focus: -1
    chatter: 0
    chapter: 
    chapterSub: 
    ambience: 
    ambVol: 0.3
    sfx: 
    sfxVol: 0.8
    operatorOnly: 0
    dark: -1
    bgm: 
    bg: -1
  - speaker: "\uB3C4\uC724"
    text: "\uC815\uC2E0\uC5C6\uB2E4\u2026 \uADF8\uB798\uB3C4 \uB2E4\uB4E4 \uBC18\uACA8
      \uC8FC\uB294 \uAC74 \uC54C\uACA0\uC5B4."
